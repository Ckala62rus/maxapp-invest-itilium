# Copy this file to `.env` before starting the project.

# Backend and proxy ports on the host.
WEB_HTTP_PORT=8088

# Postgres connection used by docker compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# Grafana local credentials.
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# Loki driver URL must point to the Docker host, not the compose service name.
LOKI_URL=http://127.0.0.1:3100/loki/api/v1/push

# Real ITILIUM values are needed in production mode.
ITILIUM_BASE_URL=
ITILIUM_LOGIN=
ITILIUM_PASSWORD=
