# Copy this file to `.env` before starting the project.

# Backend and proxy ports on the host.
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
CERT_DOMAIN=maxapp.example.com

# Grafana local credentials.
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
GRAFANA_HTTP_PORT=3001
PROMETHEUS_HTTP_PORT=9090
LOKI_HTTP_PORT=3100

# Loki driver URL must point to the Docker host, not the compose service name.
LOKI_URL=http://127.0.0.1:3100/loki/api/v1/push

# Real ITILIUM values are needed in production mode.
ITILIUM_HOST=https://10.60.25.121
ITILIUM_BASE_URL=
ITILIUM_LOGIN=
ITILIUM_PASSWORD=
ITILIUM_INSECURE_SKIP_VERIFY=false

# MAX auth values for mini app validation and backend sessions.
MAX_BOT_TOKEN=
AUTH_ACCESS_TOKEN_SECRET=change-me-to-a-long-random-secret
AUTH_ACCESS_TOKEN_TTL=12h
AUTH_MAX_INIT_DATA_TTL=10m
AUTH_ALLOW_DEBUG_IDENTITY_HEADERS=false

# Минимальный уровень логов (переопределяет logging.level в YAML). Для Debug: debug.
# Не задавайте LOG_LEVEL пустым — тогда уровень станет info (по умолчанию в logger).
# LOG_LEVEL=debug
