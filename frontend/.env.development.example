# Скопируйте в .env.development.local и при необходимости раскомментируйте.
# Файлы .env*.local не должны попадать в git (секреты / личные id).

# Прямой вызов API без proxy Vite (по умолчанию пусто — используются относительные URL и proxy в vite.config.js).
# VITE_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# Отладка без MAX: заголовок X-User-ID в DEV, если нет access_token (нужен allow_debug_identity_headers на бэкенде).
# VITE_DEBUG_USER_ID=40367639
#
# Проверка deep link из кнопки бота в обычном браузере (см. documentation/local_development.md):
# http://localhost:5173/?startapp=ticket_0000024311
